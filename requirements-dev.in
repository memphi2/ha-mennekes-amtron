# Direct validation dependencies. CI installs the selected Home Assistant
# matrix version separately. Dependabot updates requirements-dev.txt;
# requirements-dev-min-ha.txt is curated manually for the minimum matrix.
# Home Assistant itself is locked per CI matrix.
#
# pymodbus is the integration's runtime requirement. manifest.json declares a
# minimum so Home Assistant keeps owning the resolved version; the locks here
# pin the exact version of their Home Assistant matrix entry.
#
# The schema library is deliberately absent: Home Assistant replaced
# voluptuous with probatio in 2026.9 and installs it itself, so listing
# either one here would mean validating against a version Home Assistant
# does not resolve.
#
# mypy is pinned only in this lock. Home Assistant's own annotations moved
# from voluptuous to probatio in 2026.10, so the typing gate runs against
# current_homeassistant alone; see .github/workflows/validate.yml.
mypy==2.4.0
pymodbus[serial]==3.13.1
pytest==9.1.1
pytest-cov==7.1.0
ruff==0.16.10
spdx-tools==0.8.5
